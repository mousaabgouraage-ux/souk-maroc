# ===== SuMa MarKet - إعدادات البيئة (PostgreSQL) =====
# انسخ هذا الملف إلى ".env" واملأ القيم الحقيقية.
# ملاحظة: ".env" مستبعد من git لأسباب أمنية، لا ترفع الأسرار أبداً.

# ----- اتصال قاعدة البيانات (مثال: Neon) -----
# رابط التجميع (pooler) للاستخدام وقت التشغيل، مع connection_limit=1 لتوافق Prisma مع PgBouncer
DATABASE_URL="postgresql://user:password@db.region.neon.tech/suma-market?sslmode=require&connection_limit=1"
# رابط مباشر (direct) تُستخدمه Prisma للهجرات والتصدير (من Connection Details في Neon)
DIRECT_URL="postgresql://user:password@ep-....neon.tech/suma-market?sslmode=require"

# ----- بيانات مسؤول (غيّرها قبل النشر) -----
ADMIN_EMAIL="admin@sumamarket.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="كلمة-مرور-قوية-جدا"

# ----- مفتاح توقيع جلسات الدخول -----
# ولّد مفتاحاً عشوائياً جديداً لكل نشر:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="اكتب-مفتاحا-عشوائيا-طويلا-96-قيمة-سداسية"

NODE_ENV="production"