# ===== SaMu MarKet - إعدادات البيئة (PostgreSQL) =====
# انسخ هذا الملف إلى ".env" واملأ القيم الحقيقية.
# ملاحظة: ".env" مستبعد من git لأسباب أمنية، لا ترفع الأسرار أبداً.

# ----- اتصال قاعدة البيانات (مثال: Neon) -----
# رابط التجميع (pooler) للاستخدام وقت التشغيل، مع connection_limit=1 لتوافق Prisma مع PgBouncer
DATABASE_URL="postgresql://user:password@db.region.neon.tech/suma-market?sslmode=require&connection_limit=1"
# رابط مباشر (direct) تُستخدمه Prisma للهجرات والتصدير (من Connection Details في Neon)
DIRECT_URL="postgresql://user:password@ep-....neon.tech/suma-market?sslmode=require"

# ----- بيانات مسؤول (غيّرها قبل النشر) -----
ADMIN_EMAIL="admin@sumamarket.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="كلمة-مرور-قوية-جدا"

# ----- مفتاح توقيع جلسات الدخول -----
# ولّد مفتاحاً عشوائياً جديداً لكل نشر:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="اكتب-مفتاحا-عشوائيا-طويلا-96-قيمة-سداسية"

# ----- تكامل RapColis (التوصيل) -----
# تُقرأ من الخادم فقط (Server-side). لا تضع القيم الحقيقية في الكود أو git.
# القيمة الفعلية: من حسابك في RapColis > التكامل (URL Webhook / Token Client / Secret Webhook)
# ملاحظة: رمز العميل يُرسل داخل عنوان الويب‌هوك كمعامل token= (انقل الرابط حرفياً بما فيه ?token=...).
# الكود يضيفه تلقائياً من RAPCOLIS_TOKEN_CLIENT لو لم يكن موجوداً في الرابط.
RAPCOLIS_WEBHOOK_URL="https://rapcolis.ma/api/v1/webhook/autre.php?token=..."
RAPCOLIS_TOKEN_CLIENT="رمز-العميل"
RAPCOLIS_WEBHOOK_SECRET="سر-الويب-هوك"
RAPCOLIS_API_KEY="مفتاح-واجهة-rapcolis"
RAPCOLIS_API_SECRET="سر-واجهة-rapcolis"

NODE_ENV="production"
# Cloudinary (for product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CLOUDINARY_UPLOAD_PRESET=

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_PRODUCTS=product-images
SUPABASE_JWKS_URL=
SUPABASE_PUBLISHABLE_KEY=
