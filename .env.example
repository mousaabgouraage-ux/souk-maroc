# ===== SuMa MarKet — إعدادات النشر =====
# أنسخ هذا الملف إلى ".env" واملأ القيم، ولا ترفع ".env" أبداً إلى git.

# قاعدة البيانات (SQLite في مجلد prisma/)
DATABASE_URL="file:./dev.db"

# بيانات دخول صاحب المتجر (تُقرأ من البيئة فقط، لا تُعرض في الواجهة)
ADMIN_EMAIL="admin@sumamarket.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ضع-كلمة-مرور-قوية-هنا"

# سر توقيع جلسات الإدارة — غيّره لقيمة عشوائية طويلة (أولّده بأمر مثل:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="ضع-سر-عشوائي-طويل-هنا-96-حرفاً"

# ===== متغيرات اختيارية =====
# لو شغّلت الخادم خلف بروكسي HTTPS (توصية)، اضبط هذين لمنع حجب الطلبات:
# TRUSTED_HOST="your-domain.com"
# NODE_ENV="production"  # يضبطه pm2/Docker عادةً تلقائياً